{
  "multipart": [
    {
      "apply": {
        "model": "ic2:block/gold_insulated_cable_center"
      },
      "when": {
        "foamed": "0"
      }
    },
    {
      "when": {
        "north": "true",
        "foamed": "0"
      },
      "apply": {
        "model": "ic2:block/gold_insulated_cable_arm"
      }
    },
    {
      "when": {
        "east": "true",
        "foamed": "0"
      },
      "apply": {
        "model": "ic2:block/gold_insulated_cable_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true",
        "foamed": "0"
      },
      "apply": {
        "model": "ic2:block/gold_insulated_cable_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true",
        "foamed": "0"
      },
      "apply": {
        "model": "ic2:block/gold_insulated_cable_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true",
        "foamed": "0"
      },
      "apply": {
        "model": "ic2:block/gold_insulated_cable_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true",
        "foamed": "0"
      },
      "apply": {
        "model": "ic2:block/gold_insulated_cable_arm",
        "x": 90
      }
    },
    {
      "apply": {
        "model": "ic2:block/cable_foam_wet"
      },
      "when": {
        "foamed": "1"
      }
    },
    {
      "apply": {
        "model": "ic2:block/construction_foam"
      },
      "when": {
        "foamed": "2"
      }
    }
  ]
}
